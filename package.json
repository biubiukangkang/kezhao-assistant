{
  "name": "kezhao-assistant",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "tsr generate && oxlint src && tsc --noEmit",
    "test": "vitest run",
    "audit:offline": "node scripts/audit-offline.mjs",
    "app:sync": "npm run build && cap sync android",
    "app:debug": "npm run app:sync && cd android && gradlew.bat assembleDebug",
    "app:release": "npm run app:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
